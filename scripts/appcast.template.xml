<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 6 Plan 06-04 (REL-06) — initial empty-channel Sparkle 2.x appcast.

  Seeds the `gh-pages` branch before the first release so the SUFeedURL
  resolves to valid XML even with zero published items. Sparkle handles a
  channel with no <item> elements gracefully (RESEARCH Open Question 2).

  After each release, scripts/append_appcast_item.py PREPENDS a new
  <item> with the EdDSA signature + length produced by `sign_update`.

  OWNER placeholder is replaced by the GitHub Pages owner handle when the
  user initializes the gh-pages branch in plan 06-05 (consistent with the
  06-02 SUFeedURL placeholder in AgentsUsageBar/Resources/Info.plist).
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Agents Usage Bar</title>
        <link>https://github.com/noomzopendream/agents_usage_bar</link>
        <description>Agents Usage Bar update feed</description>
        <language>en</language>
    </channel>
</rss>
