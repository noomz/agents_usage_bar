<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Plan 06-02 (D-03 / D-05 / REL-01) — Developer ID export options for
	  `xcodebuild -exportArchive`. The CI release workflow consumes this to re-sign
	  the archived .app and its nested Sparkle helpers (Installer.xpc,
	  Downloader.xpc, Autoupdate, Updater.app) with Developer ID Application +
	  Hardened Runtime before DMG packaging and notarization.
	  NOTE on `hardenedRuntime`: RESEARCH Pattern 3 contains a typo (`hardendedRuntime`);
	  the correct Apple key is `hardenedRuntime` and is used here. Apple validates this
	  key by exact spelling — the typo silently disables Hardened Runtime in the export.
	  NOTE on `teamID`: -exportArchive does NOT expand $(DEVELOPMENT_TEAM) here. The
	  release workflow writes the real team ID into a copy with plutil before export.
	  NOTE on `signingStyle`: manual, because the CI runner has no Xcode account for
	  automatic signing; it signs with the imported Developer ID Application identity.
	-->
	<key>method</key>
	<string>developer-id</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Developer ID Application</string>
	<key>teamID</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>hardenedRuntime</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
